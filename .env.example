# Neon Database (injected by Vercel Marketplace integration)
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:pass@host/db?sslmode=require

# Auth - Argon2id hash of studio password
# Generate with: npx argon2 hash "your-password"
STUDIO_PASSWORD_HASH=

# Vercel Blob (auto-injected when connected via Vercel dashboard)
BLOB_READ_WRITE_TOKEN=
